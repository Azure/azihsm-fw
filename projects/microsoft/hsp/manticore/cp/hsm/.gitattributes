#
# Declare files that will always have LF line endings on checkout.
#
*.rs                   text eol=lf
*.toml                 text eol=lf
*.c                    text eol=lf
*.h                    text eol=lf
*.x                    text eol=lf
*.xml                  text eol=lf
*.md                   text eol=lf
LICENSE                text eol=lf
vendored/cortex-m/*    text eol=lf

#
# Denote all files that are truly binary and should not be modified
#
*.o           binary
